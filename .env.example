# 数据库连接（Neon 免费层）
AM_DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/agent_monitor?ssl=require
AM_DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/agent_monitor?sslmode=require

# 监控平台 LLM（质量评估 LLM-as-Judge）
AM_LLM_API_KEY=your-api-key
AM_LLM_BASE_URL=https://api.openai.com/v1
AM_LLM_MODEL=gpt-4o

# Demo 投顾 Agent LLM（独立 key，不设则回退到 AM_LLM_*）
DEMO_LLM_API_KEY=your-api-key
DEMO_LLM_BASE_URL=https://api.deepseek.com/v1
DEMO_LLM_MODEL=deepseek-chat
